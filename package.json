{
  "name": "designbeen-agency-cms",
  "private": true,
  "version": "1.0.0",
  "description": "DesignBeen agency website UI rebuilt as a React + Express + MySQL CMS",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "nodemon server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "seed:hash": "node server/utils/hash-password.js",
    "db:setup": "node server/utils/setup-database.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "axios": "^1.8.4",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "framer-motion": "^12.6.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "vite": "^6.1.0"
  }
}
